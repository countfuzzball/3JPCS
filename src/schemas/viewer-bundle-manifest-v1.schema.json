{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://polygon-county.invalid/viewer-bundle-manifest-v1.schema.json",
  "title": "Polygon County Viewer Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "project_name", "contents"],
  "properties": {
    "format": { "const": "polygon-county-viewer-bundle" },
    "schema_version": { "const": 1 },
    "project_name": { "type": "string", "minLength": 1 },
    "contents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_scenery", "resampled_vegetation", "asset_catalog"],
      "properties": {
        "runtime_scenery": { "$ref": "#/$defs/runtimeScenery" },
        "resampled_vegetation": {
          "oneOf": [
            { "$ref": "#/$defs/resampledVegetation" },
            { "type": "null" }
          ]
        },
        "asset_catalog": {
          "oneOf": [
            { "$ref": "#/$defs/assetCatalog" },
            { "type": "null" }
          ]
        }
      }
    }
  },
  "$defs": {
    "jsonFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "media_type", "schema_version"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$" },
        "media_type": { "const": "application/json" },
        "schema_version": { "type": "integer", "minimum": 1 },
        "format": { "type": "string", "minLength": 1 }
      }
    },
    "runtimeScenery": {
      "allOf": [
        { "$ref": "#/$defs/jsonFile" },
        {
          "type": "object",
          "required": ["format"],
          "properties": {
            "format": { "const": "polygon-county-runtime-scenery" },
            "schema_version": { "const": 3 }
          }
        }
      ]
    },
    "resampledVegetation": {
      "allOf": [
        { "$ref": "#/$defs/jsonFile" },
        {
          "type": "object",
          "properties": { "schema_version": { "const": 1 } }
        }
      ]
    },
    "assetCatalog": {
      "allOf": [
        { "$ref": "#/$defs/jsonFile" },
        {
          "type": "object",
          "required": ["format"],
          "properties": {
            "format": { "const": "polygon-county-asset-catalog" },
            "schema_version": { "const": 3 }
          }
        }
      ]
    }
  }
}
